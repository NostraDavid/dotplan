{
  "name": "nostradavid-dotplan",
  "displayName": "dotplan by NostraDavid",
  "version": "1.0.1",
  "description": "Syntax highlighting for .plan files, with task, question, idea, command, debt, cleanup, and day markers.",
  "categories": [
    "Programming Languages"
  ],
  "homepage": "https://github.com/NostraDavid/dotplan#readme",
  "bugs": {
    "url": "https://github.com/NostraDavid/dotplan/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NostraDavid/dotplan.git"
  },
  "license": "MIT",
  "author": "NostraDavid",
  "publisher": "nostradavid",
  "scripts": {
    "test": "npm run type-check && node --test test/*.test.mts",
    "build": "node scripts/validate.mts",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --githubBranch master",
    "release:check": "node scripts/release-notes.mts",
    "type-check": "tsc --noEmit"
  },
  "contributes": {
    "languages": [
      {
        "id": "dotplan",
        "aliases": [
          "dotplan",
          ".plan"
        ],
        "filenames": [
          ".plan"
        ],
        "extensions": [
          ".plan"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dotplan",
        "scopeName": "source.dotplan",
        "path": "./syntaxes/dotplan.tmLanguage.json"
      }
    ]
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  }
}
